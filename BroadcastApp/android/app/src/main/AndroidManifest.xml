<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 采集系统声音（内录）：需要前台服务 + MediaProjection 授权；Android 13+ 通知要用户允许 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- 送话期间的前台服务（类型 microphone）。Android 12+ 后台采集麦克风**必须**有它，
         否则系统会把麦克风静音；有了它进程也不会在息屏时被冻结（只要不退出 App 话筒就能用）。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 扫码配置（自写解码走 CameraX，需要相机权限） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:label="广播系统手控端"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:label="广播系统手控端"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 采集系统声音时必挂的前台服务（Android 14+ 硬要求；只挂通知，不录屏） -->
        <service
            android:name=".MediaProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 送话（话筒）期间必挂的前台服务：Android 12+ 后台采集麦克风必须有它，否则系统会静音麦克风；
             同时也避免息屏时进程被冻结 —— 用户要求"只要不退出 App，话筒就能用"。 -->
        <service
            android:name=".MicForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- 排错日志导出：把 App 私有目录里的 logs/*.txt 通过 FileProvider 分享出去（微信/邮件等） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
